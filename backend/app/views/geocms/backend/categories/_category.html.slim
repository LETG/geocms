tr
  td
    - category.depth.times do |hey|
      span.left-space
    .btn.btn-group
      = move_link move_backend_category_path(category, direction: "down"), "down", category.last?
      = move_link move_backend_category_path(category, direction: "up"), "up", category.first?
    span.name class="depth-#{category.depth}" = link_to category.name, backend_category_path(category)
    td.actions
      = link_to new_backend_category_path(parent_id: category.id), rel: "tooltip", "data-original-title" => t('modules.categories.new') do
        i.glyphicon.glyphicon-plus.glyphicon.glyphicon-white
    td.actions
      = link_to edit_backend_category_path(category), rel: "tooltip", "data-original-title" => t("actions.default.edit") do
        i.glyphicon.glyphicon-pencil.glyphicon.glyphicon-white
    td.actions
      = link_to backend_category_path(category), confirm: "#{t('messages.confirm')}", method: :delete do
        i.glyphicon.glyphicon-trash.glyphicon.glyphicon-white
