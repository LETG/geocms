IFS=$' \t\n'
PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

unset GEM_PATH
unset GEM_HOME
unset RUBY_VERSION
unset MY_RUBY_HOME
unset rvm_bin_path
unset IRBRC
unset rvm_path
unset rvm_prefix
unset rvm_version


info() {
  cat <<-EOH
  install-geocms
  Ce script réalise une installation semi automatique de
  geocms, un visualiseur simple et clair de données
  géoréférencées.
  https://github.com/dotgee/geocms

  Ce script doit être lancé
    - sous le compte root
    - sur une machine Ubuntu 20.04 ou +
      machine vierge de préférence.

  Il va :
    - mettre à jour le système (apt-get update/upgrade)
    - installer de nombreux paquets debian
    - créer deux utilisateurs systèmes dédiés
    - créer une base de données locale, postgresql (ou utiliser une
      base existante). Vous pourrez également la déplacer par la suite.
    - installer rvm en mode single user
    - installer tous les composants et services nécessaires à geocms
    - installer ruby 2.2.0 grâce à rvm,
    - dans un gemset de rvm, installer rails et geocms
    - Créer une première instance du visualiseur
    - créer un compte d'administration de l'application.
    - complètement modifier la configuration de nginx

$(bold)$(brown_foreground)$(red_background)  install-geocms génère un rapport. Ne le perdez pas,
  ne le laissez pas trainer. Il contient non seulement
  l'ensemble des fichiers de configuration, mais aussi
  des mots de passe.$(default_background_color)$(default_foreground)$(normal_intensity)
	EOH
}



info_besoin() {
  cat <<-EOH
    La machine debuntu doit avoir accès à internet et pouvoir
    - se connecter aux dépôts de paquets
    - se connecter à github pour récupérer l'application.
	EOH
}

help() {
  cat <<-EOH | sed -e 's/^    //'
    ${O##*} [--clean-temp]

    Ce script automatise l'installation de geocms, de bout en bout.
    Il est interactif. On peut le lancer plusieurs fois de suite. S'il
    se plante sur une étape.

    Entre ses différents lancement, il mémorise, les réponses, ainsi que
    les étapes déjà réalisées. Pour recommencer du début. utiliser
    l'option --clean-temp

    Il faut le lancer sous le compte root. Aucune modification n'est
    effectuée tant que vous n'avez pas validé que vous voulez vraiment
    les faire.

    /Schplurtz.
	EOH
}


openf() {
  exec 3>&1
  exec >"$1"
}
closef() {
  exec >&3
  exec 3>&-
}
mkfile() {
  openf "$1"
  cat
  closef
}
unbase64() { /usr/bin/base64 -d; }
mkfile64() {
  unbase64 | mkfile "$@"
}

set -e # stop on errors
tempdir=/tmp/install-geocms.temp
mkdir -p $tempdir
cd $tempdir
chmod 1777 $tempdir # yep, I need that
