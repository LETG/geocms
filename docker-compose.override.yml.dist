version: '3.9'

services:
  app:
    build:
      target: "development"
    volumes:
      - rails_cache:/app/tmp/cache
      - bundle:/bundle
      - .:/geocms

  cron:
    build:
      target: "development"
    volumes:
      - rails_cache:/app/tmp/cache
      - bundle:/bundle
      - .:/geocms

  sidekiq:
    build:
      target: "development"
    volumes:
      - rails_cache:/app/tmp/cache
      - bundle:/bundle
      - .:/geocms

volumes:
  postgres:
  redis:
  rails_cache:
  bundle:
